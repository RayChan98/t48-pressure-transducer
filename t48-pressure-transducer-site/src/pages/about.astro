---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

const factoryStats = [
  { value: 'In-house', label: 'Machining, assembly, calibration and testing under one roof' },
  { value: '-1 to 600 bar', label: 'Standard pressure ranges, custom ranges in between' },
  { value: '100%', label: 'Of units individually calibrated before shipment' },
  { value: '±0.25% FS', label: 'Standard accuracy; ±0.1% FS on high-accuracy models' },
];

const qcSteps = [
  { title: 'Individual calibration', desc: 'Every transducer is calibrated on a deadweight or digital reference standard that is NIST-traceable. Zero, span and linearity are set and recorded for each serial number.' },
  { title: 'Temperature compensation check', desc: 'Compensation curves are verified over the operating temperature range so output drift stays within the published specification.' },
  { title: 'Pressure test', desc: 'Each unit is proof-pressure tested to the rated overpressure for its model before the diaphragm and weld joints are cleared for shipment.' },
  { title: 'Final inspection', desc: 'Electrical output, insulation resistance, process thread and cable integrity are checked, and calibration certificates are prepared on request.' },
];

const directReasons = [
  { title: 'Factory-direct pricing', desc: 'You buy from the manufacturer, not a distributor. No reseller margin on transducers, transmitters or custom OEM builds.' },
  { title: 'Direct engineering access', desc: 'Specify range, output, connection and media — our engineers confirm a suitable model with datasheet and price, not a generic catalog page.' },
  { title: 'OEM/ODM support', desc: 'Private-label pressure sensors built to your drawings and brand, from prototype to production volumes.' },
  { title: 'Short, controlled lead times', desc: 'Production planning is under our control, so standard models ship in 7-15 days and custom builds follow a confirmed schedule.' },
];
---

<Layout title="About PRESSUREPOINT — Pressure Transducer Manufacturer" description="PRESSUREPOINT is a factory-direct pressure transducer manufacturer: in-house machining, assembly and NIST-traceable calibration, CE marking and ISO 9001 quality.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-night-green">ABOUT US</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Pressure Measurement, Built and Calibrated In-House</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">PRESSUREPOINT is a manufacturer of industrial pressure transducers and transmitters. We machine, assemble, calibrate and test every unit in our own facility — no outsourced assembly, no outsourced quality control.</p>
    </div>
  </section>

  <!-- 工厂实力 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold text-brand-blue">OUR FACTORY</p>
          <h2 id="factory" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Factory &amp; Facility</h2>
          <div class="mt-6 space-y-4 text-sm leading-relaxed text-slate-600">
            <p>Our production facility covers the full manufacturing chain for pressure transducers: CNC machining of stainless housings and process connections, diaphragm welding and media-isolation assembly, electronics assembly and potting, and a calibration area with reference standards used for every unit that leaves the plant.</p>
            <p>Because machining, assembly and calibration happen in-house, we control tolerances, materials and test records end to end. That is what allows us to offer custom ranges, custom connections and private-label builds at production scale without losing traceability.</p>
            <p>Standard production covers ranges from vacuum (-1 bar) to 600 bar, 4-20mA / 0-10V / RS485 outputs, and 316L stainless wetted parts with Hastelloy or ceramic diaphragm options for aggressive media.</p>
          </div>
        </div>
        <div>
          <div class="grid grid-cols-2 gap-4">
            {factoryStats.map((s) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
                <p class="text-xl font-extrabold text-navy-950">{s.value}</p>
                <p class="mt-2 text-xs leading-relaxed text-slate-500">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 质检流程 -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">QUALITY CONTROL</p>
      <h2 id="quality" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Every Unit Calibrated, NIST-Traceable</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">Each pressure transducer is calibrated individually before shipment — we do not sample-test. Calibration is performed against reference standards with NIST-traceable certificates, and the results are recorded against the unit's serial number.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {qcSteps.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-base font-bold text-navy-950">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-slate-400">Calibration certificates, material certificates and test reports are available on request for any order.</p>
    </div>
  </section>

  <!-- 技术能力 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold text-brand-blue">TECHNOLOGY</p>
          <h2 id="technology" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Sensing Technology &amp; Signal Conditioning</h2>
          <div class="mt-6 space-y-4 text-sm leading-relaxed text-slate-600">
            <p>Our transducers use piezoresistive sensing elements with integrated signal conditioning. The pressure diaphragm — stainless 316L as standard, Hastelloy or ceramic for corrosive media — isolates the sensing element from the process medium while transmitting pressure faithfully.</p>
            <p>On-board electronics convert the raw bridge signal into standard industrial outputs: 4-20mA two-wire, 0-10V or 0-5V three-wire, and RS485 Modbus for digital buses. Temperature compensation is applied over the operating range to control zero and span drift.</p>
            <p>Housings are designed for continuous industrial service with IP65/IP67 ingress protection as standard, IP68 for submersible level transmitters, and EMC protection to meet CE requirements.</p>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <h3 class="text-lg font-bold text-navy-950">Standard technical envelope</h3>
          <ul class="mt-4 space-y-3 text-sm text-slate-600">
            <li><strong>Ranges:</strong> vacuum (-1 bar) to 600 bar, custom ranges available</li>
            <li><strong>Outputs:</strong> 4-20mA, 0-10V, 0-5V, RS485 Modbus, HART</li>
            <li><strong>Accuracy:</strong> ±0.25% FS standard, ±0.1% FS high accuracy</li>
            <li><strong>Wetted parts:</strong> 316L stainless, Hastelloy C-276, ceramic</li>
            <li><strong>Connections:</strong> G1/4, G1/2, 1/4" &amp; 1/2" NPT, M20×1.5, M12×1.5, flush diaphragm</li>
            <li><strong>Protection:</strong> IP65 / IP67, IP68 submersible</li>
            <li><strong>Media temperature:</strong> -40°C to +125°C (model dependent)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 认证 -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">CERTIFICATIONS</p>
      <h2 id="certificates" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Certifications &amp; Compliance</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-bold text-navy-950">CE Marking</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Pressure transducers are designed and tested to meet the EMC and low-voltage directives, with EMC protection on the electronics and documented test results available on request.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-bold text-navy-950">ISO 9001 Quality System</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Our quality management system follows ISO 9001 principles covering incoming material inspection, in-process control, calibration records and corrective action.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-base font-bold text-navy-950">RoHS &amp; Documentation</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Materials and components are sourced RoHS-compliant. For OEM and regulated projects we prepare the documentation package you require: calibration certificates, material certs, test reports and CE declarations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 生产流程 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">PRODUCTION PROCESS</p>
      <h2 id="process" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">From Specification to Shipment</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {[
          { t: 'Specification review', d: 'Range, media, output, connection, accuracy and volume are confirmed against application requirements.' },
          { t: 'Machining & assembly', d: 'Housings and connections are CNC-machined; diaphragm welding and electronics assembly are completed in-house.' },
          { t: 'Individual calibration', d: 'Every unit is calibrated against NIST-traceable reference standards and temperature-compensated.' },
          { t: '100% test & dispatch', d: 'Proof-pressure test, electrical check and final inspection, then documented shipment.' },
        ].map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <p class="text-sm font-bold text-navy-950">{s.t}</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 供应链 -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">SUPPLY CHAIN</p>
      <h2 id="supply-chain" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Materials, Sourcing &amp; Logistics</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-slate-600">
        <p>Stainless 316L bar stock and sheet come from certified mills, and Hastelloy and ceramic diaphragms are sourced from specialist suppliers when a project needs them. Electronic components are purchased from qualified vendors and inspected on receipt.</p>
        <p>Finished goods ship worldwide with export packaging and full documentation. For volume programs we can schedule production against your forecast to keep stock levels predictable.</p>
      </div>
    </div>
  </section>

  <!-- 为什么工厂直销 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">FACTORY DIRECT</p>
      <h2 id="factory-direct" class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Why Buy Factory Direct</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {directReasons.map((r) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            <h3 class="text-base font-bold text-navy-950">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Talk to the Factory About Your Pressure Sensor"
    subtitle="Send your range, media, output signal and volume — our engineers reply with a suitable model, datasheet and pricing within 24 hours."
  />
</Layout>
