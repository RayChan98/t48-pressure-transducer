---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = [
  {
    title: 'OEM & ODM Manufacturing',
    icon: '🏷️',
    desc: 'Custom and private-label pressure transducers built to your specification: custom ranges from vacuum to 600 bar, any output signal, your process connection, your brand and packaging. Prototype in 15-20 days, NIST-traceable calibration on every unit.',
    href: '/services/oem-odm/',
    cta: 'View OEM & ODM Service',
  },
  {
    title: 'Calibration Service',
    icon: '📏',
    desc: 'Every PRESSUREPOINT transducer is individually calibrated against NIST-traceable reference standards before shipment, and calibration certificates are available on request for any order or project.',
    href: '/contact/',
    cta: 'Request Calibration Details',
  },
  {
    title: 'Wholesale & Distribution',
    icon: '📦',
    desc: 'Volume pricing for distributors, machine builders and trading partners — scheduled production against your forecast, consistent branding and documentation for your market.',
    href: '/contact/',
    cta: 'Ask About Wholesale Pricing',
  },
];

const engagement = [
  { t: '1. Send your specification', d: 'Range, media, output, connection, volume — by email or the inquiry form.' },
  { t: '2. Get a confirmed quote', d: 'Engineers confirm a suitable model or custom build with datasheet and price within 24 hours.' },
  { t: '3. Samples or production', d: 'Custom builds start with samples; standard models ship from stock in 7-15 days.' },
];
---

<Layout title="Services | OEM/ODM, Calibration & Wholesale — PRESSUREPOINT" description="PRESSUREPOINT services: OEM/ODM pressure transducer manufacturing, NIST-traceable calibration, and wholesale programs for distributors and machine builders. Factory-direct support with confirmed lead times.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-night-green">SERVICES</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Manufacturing Services for Pressure Measurement</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">Beyond catalog transducers — custom builds, private label, calibration traceability and volume programs, all factory-direct from PRESSUREPOINT.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-blue/10 text-xl">{s.icon}</span>
            <h2 class="mt-4 text-lg font-bold text-navy-950">{s.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{s.desc}</p>
            <a href={s.href} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue transition hover:text-navy-950">
              {s.cta} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">HOW TO ENGAGE</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Working With Us</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {engagement.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold text-navy-950">{s.t}</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.d}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-slate-600">
        Not sure which service fits? Send your application details to <a href="mailto:cj226144@gmail.com" class="font-semibold text-brand-blue hover:underline">cj226144@gmail.com</a> and our engineers will point you the right way.
      </p>
    </div>
  </section>

  <CtaBand
    title="Start a Custom Pressure Sensor Project"
    subtitle="Specification, volume, branding — send us the details and get a confirmed quote with lead time within 24 hours."
  />
</Layout>
