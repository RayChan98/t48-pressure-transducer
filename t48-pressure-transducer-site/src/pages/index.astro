---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';

const products = [
  {
    title: 'Industrial Pressure Transducers',
    description: 'General-purpose pressure transducers with 4-20mA or 0-10V output — the workhorse for hydraulic systems, pumps, compressors and machine builders.',
    href: '/products/industrial/',
    tag: '4-20MA · 0-10V',
  },
  {
    title: 'High Accuracy Transducers',
    description: '0.1% FS precision models with low temperature drift for test stands, process control and OEM instrumentation where measurement certainty matters.',
    href: '/products/high-accuracy/',
    tag: '±0.1% FS',
  },
  {
    title: 'Miniature Pressure Sensors',
    description: 'Compact OEM sensor modules from 12mm diameter for embedded applications — medical devices, pneumatics, robotics and handheld instruments.',
    href: '/products/miniature/',
    tag: 'OEM MODULES',
  },
  {
    title: 'Differential Pressure Transducers',
    description: 'Pressure-difference measurement for airflow, filter monitoring and level measurement — with wet/wet and wet/dry options.',
    href: '/products/differential/',
    tag: 'WET/WET · AIR',
  },
  {
    title: 'Flush Diaphragm Transducers',
    description: 'Hygienic and viscous-media models with flush stainless diaphragms for food, pharma and polymerization processes — no dead volume.',
    href: '/products/flush-diaphragm/',
    tag: 'HYGIENIC',
  },
  {
    title: 'Submersible Level Transmitters',
    description: 'Hydrostatic level transmitters for tanks, wells and boreholes — with ventilation tube and IP68 cable for continuous level monitoring.',
    href: '/products/submersible/',
    tag: 'LEVEL · IP68',
  },
];

const features = [
  { title: 'Factory-Direct Pricing', desc: 'Sensor manufacturer selling direct — no distributor markup on pressure transducers, transmitters and custom OEM builds.' },
  { title: 'Full Output Range', desc: '4-20mA two-wire, 0-10V / 0-5V three-wire, RS485 Modbus and HART — every industrial controller covered.' },
  { title: 'OEM & ODM Support', desc: 'Private-label pressure sensors built to your drawings and brand, with application engineering included.' },
  { title: 'Calibrated & Tested', desc: 'Every unit individually calibrated against NIST-traceable standards and pressure-tested before shipping.' },
  { title: 'Custom Ranges & Media', desc: 'From vacuum to 600 bar, stainless 316L / Hastelloy / ceramic diaphragms, and media-isolated options.' },
  { title: 'Global Shipping', desc: 'Fast DDP delivery worldwide with full documentation, CE declarations and export packaging.' },
];
---

<Layout title="Pressure Transducer Manufacturer | 4-20mA & 0-10V Transmitters" description="PRESSUREPOINT is a pressure transducer and transmitter manufacturer. Factory-direct industrial pressure transducers with 4-20mA, 0-10V and RS485 outputs, plus differential, flush diaphragm, miniature and submersible models with OEM/ODM support.">
  <Hero
    title="Industrial Pressure Transducers & Transmitters, Factory Direct"
    subtitle="Measure hydraulic, pneumatic, water and process pressure reliably — from vacuum to 600 bar. PRESSUREPOINT manufactures pressure transducers and transmitters with 4-20mA, 0-10V and RS485 outputs, factory-direct with OEM/ODM support and application engineering."
    ctaPrimary="Get a Quote"
    ctaPrimaryHref="/contact/"
    ctaSecondary="View Products"
    ctaSecondaryHref="/products/"
    badge="PRESSURE TRANSDUCER MANUFACTURER"
  />

  <!-- 产品线网格 -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-extrabold text-navy-950">Pressure Transducer Product Lines</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">Six families cover the full spectrum of industrial pressure measurement — all available with custom ranges, outputs and process connections.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <ProductCard title={p.title} description={p.description} href={p.href} tag={p.tag} />
        ))}
      </div>
    </div>
  </section>

  <!-- 核心能力 -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-extrabold text-navy-950">Why Buy Factory Direct from PRESSUREPOINT</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
            <h3 class="text-lg font-bold text-navy-950">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 应用行业带 -->
  <section class="bg-navy-950 py-14 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-center text-2xl font-extrabold">Pressure Measurement for Every Industry</h2>
      <div class="mt-8 grid grid-cols-2 gap-4 text-center sm:grid-cols-3 lg:grid-cols-7">
        <a href="/industries/hydraulic/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">🛢️ Hydraulics</a>
        <a href="/industries/hvac/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">❄️ HVAC</a>
        <a href="/industries/water/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">💧 Water</a>
        <a href="/industries/compressed-air/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">💨 Air</a>
        <a href="/industries/process/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">⚗️ Process</a>
        <a href="/industries/oil-gas/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">🛢️ Oil & Gas</a>
        <a href="/industries/automation/" class="rounded-xl bg-white/10 px-3 py-4 text-sm font-semibold transition hover:bg-white/20">⚙️ OEM</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Need a Pressure Transducer Specified? Send Us Your Parameters."
    subtitle="Range, media, output signal, process connection and accuracy — our engineers confirm a suitable model with datasheet and pricing the same day."
  />
</Layout>
