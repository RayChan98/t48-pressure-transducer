---
import Layout from '../../layouts/Layout.astro';
// 触点=src/data/site.ts 单源
import { site } from '../../data/site.ts';
---

<Layout
  title="Cookie Policy | PRESSUREPOINT"
  description="PRESSUREPOINT cookie policy — which cookies we set, what Google Analytics collects, how consent works and how to change your choice."
>
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h1 class="text-4xl font-extrabold tracking-tight">Cookie Policy</h1>
      <p class="mt-4 max-w-2xl text-slate-300">
        A plain-language list of the cookies this website uses, and how to say no to the optional ones.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 prose prose-slate">
      <h2>Cookies we use</h2>
      <p>
        Necessary cookies are needed for the site to work (for example remembering your cookie choice). Analytics cookies are
        optional: they tell us which pages people read and where they come from, so we can improve the site. We do not run
        advertising cookies, we do not sell data, and we do not use analytics to identify you personally.
      </p>

      <h2>Third-party service: Google Analytics 4</h2>
      <p>
        When you choose “Accept all”, this site loads Google Analytics 4 (property measurement ID
        <strong>{site.ga4Id || 'G-2KKBHVWHM7'}</strong>), a service of Google LLC. Google Analytics sets the following cookies:
      </p>
      <table>
        <thead>
          <tr>
            <th>Cookie</th>
            <th>Purpose</th>
            <th>Typical lifetime</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>_ga</code></td>
            <td>Distinguishes one browser from another so we can count visitors without identifying them.</td>
            <td>Up to 2 years</td>
          </tr>
          <tr>
            <td><code>_ga_2KKBHVWHM7</code></td>
            <td>Keeps a single session consistent (visit state) for this property.</td>
            <td>Up to 2 years</td>
          </tr>
        </tbody>
      </table>
      <p>
        Analytics data is stored on Google servers and is kept for up to 14 months in our reports. We only see aggregated
        numbers (page views, traffic source, country, device type) plus the inquiry form event — never what you type into a form.
      </p>

      <h2>Your choice, and how to change it</h2>
      <p>
        Our consent banner appears on every page until you choose. If you pick “Necessary only”, Google Analytics runs in a
        cookieless, consent-denied mode: no <code>_ga</code> cookies are written to your browser. You can change your mind at
        any time by clicking <button type="button" data-cookie-reopen class="underline underline-offset-2">Cookie settings</button>
        on this page or in the website footer — the banner will come back and you can choose again.
      </p>
      <p>
        You can also block analytics cookies in your browser settings, or install Google's opt-out add-on:
        <a href="https://tools.google.com/dlpage/gaoptout" rel="nofollow noopener" target="_blank">tools.google.com/dlpage/gaoptout</a>.
        Blocking analytics cookies does not affect the forms or any other part of the site.
      </p>

      <h2>Questions</h2>
      <p>
        For any question about cookies or privacy, email us at <a href={`mailto:${site.email}`}>{site.email}</a>. See also our
        <a href="/legal/privacy/">Privacy Policy</a>.
      </p>
    </div>
  </section>
</Layout>
