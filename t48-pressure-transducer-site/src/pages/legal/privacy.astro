---
import Layout from '../../layouts/Layout.astro';
// 触点=src/data/site.ts 单源（补闸单 t_6989122a 10-13）
import { site } from '../../data/site.ts';
---

<Layout title="Privacy Policy | PRESSUREPOINT" description="PRESSUREPOINT privacy policy — how we handle inquiry data and personal information.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h1 class="text-4xl font-extrabold tracking-tight">Privacy Policy</h1>
    </div>
  </section>
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 prose prose-slate">
      <h2>Information We Collect</h2>
      <p>When you submit an inquiry through our website, we collect your name, email address, company name and the details of your request (product, quantity, working conditions).</p>
      <h2>How We Use Your Information</h2>
      <p>We use the information you provide solely to respond to your inquiry, prepare quotes and communicate about your order. We do not sell or share your personal information with third parties.</p>
      <h2>Email Communication</h2>
      <p>Inquiries are sent to our sales team by email. You may receive follow-up messages related to your inquiry; you can ask to be removed from our mailing list at any time.</p>
      <h2>Data Retention</h2>
      <p>Inquiry data is retained as long as needed to serve your request and meet legal record-keeping requirements.</p>
      <h2>Cookies and Analytics</h2>
      <p>
        With your consent we use Google Analytics 4 to understand how visitors use this site — which pages are read, which
        country and device a visit comes from, and whether an inquiry form was submitted. We do not send the contents of any
        form to analytics. Optional analytics cookies are only set after you choose “Accept all” in the cookie banner; choosing
        “Necessary only” keeps analytics in a cookieless, consent-denied mode. You can change your choice at any time via
        “Cookie settings” in the footer. Full cookie list:
        <a href="/legal/cookie-policy/">Cookie Policy</a>.
      </p>
      <h2>Contact</h2>
      <p>For any privacy-related questions, contact us at {site.email}.</p>
    </div>
  </section>
</Layout>
