---
import Layout from '../layouts/Layout.astro';

const faqs = [
  { q: 'What is the difference between a pressure transducer and a pressure transmitter?', a: 'In practice the terms are used interchangeably for most industrial products. Strictly, a transmitter includes signal conditioning and produces a standard output (4-20mA, 0-10V), while a transducer can refer to the sensing element alone. Every PRESSUREPOINT model ships as a complete, ready-to-wire instrument with the output signal you specify.' },
  { q: 'Which output signal should I choose: 4-20mA or 0-10V?', a: '4-20mA two-wire is the industrial standard — immune to voltage drop over long cable runs and supported by every PLC. Choose 0-10V for short runs and simple controllers, or RS485 Modbus when you need to daisy-chain many sensors on one bus.' },
  { q: 'What pressure ranges are available?', a: 'From vacuum (-1 bar) to 600 bar standard, with custom ranges in between. Common standards: 0-1, 0-6, 0-10, 0-16, 0-25, 0-40, 0-100, 0-250, 0-400, 0-600 bar. Tell us your working range and we confirm the best model.' },
  { q: 'Can you customise the process connection?', a: 'Yes — G1/4, G1/2, 1/4" NPT, 1/2" NPT, M20×1.5, M12×1.5, flush diaphragm and custom threads are available. Send your drawing or spec and we produce to it.' },
  { q: 'What is the typical lead time?', a: 'Standard models ship in 7-15 days. Custom OEM builds (range, connection, output, cable) typically 15-25 days after drawing confirmation. Small MOQ from 10 pcs for standard models.' },
  { q: 'What is the warranty?', a: 'All pressure transducers carry a 12-month warranty against manufacturing defects, and are individually calibrated against NIST-traceable standards before shipping.' },
];
---

<Layout title="Pressure Transducer FAQ" description="Frequently asked questions about pressure transducers and transmitters — output signals, pressure ranges, process connections, custom OEM builds, MOQ and lead times.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <nav class="text-sm text-slate-400">
        <a href="/" class="hover:text-white">Home</a> <span class="mx-1">/</span>
        <span class="text-slate-200">FAQ</span>
      </nav>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight">Pressure Transducer FAQ</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">Answers to the questions engineers and buyers ask most when specifying pressure transducers and transmitters.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <summary class="flex cursor-pointer items-center justify-between text-lg font-bold text-navy-950">
              {f.q}
              <span class="ml-4 shrink-0 text-brand-blue transition group-open:rotate-45">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              </span>
            </summary>
            <p class="mt-4 text-base leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
