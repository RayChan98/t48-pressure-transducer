          <li><a href="/industries/compressed-air/" class="transition hover:text-white">Compressed Air</a></li>
          <li><a href="/industries/process/" class="transition hover:text-white">Process Industries</a></li>
          <li><a href="/industries/oil-gas/" class="transition hover:text-white">Oil &amp; Gas</a></li>
